{
  "name": "matterweave-lambdas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Async processing and API handlers for MatterWeave (AWS Lambda, Node.js 22).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/handlers/*.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --external:@aws-sdk/*"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "latest",
    "@anthropic-ai/sdk": "latest",
    "@aws-sdk/client-kms": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/client-textract": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
